{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "separateMinorPatch" : true,
  "separateMultipleMajor": true,
  "separateMultipleMinor": true,
  "packageRules": [
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "matchNewValue": "^[vV]?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*)$",
      "branchPrefix": "renovate-terraform-prerelease-",
      "ignoreUnstable": false
    }
  ]
}
