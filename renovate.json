{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "separateMinorPatch" : true,
  "separateMultipleMajor": true,
  "separateMultipleMinor": true,
  "packageRules": [
   {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "branchPrefix": "renovate-terraform-stable-",
      "ignoreUnstable": true,
      "versioning": "semver"
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "branchPrefix": "renovate-terraform-prerelease-",
      "ignoreUnstable": false,
      "versioning": "semver"
    }
  ]
}
