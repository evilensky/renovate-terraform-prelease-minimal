{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "separateMinorPatch" : true,
  "separateMultipleMajor": true,
  "separateMultipleMinor": true,
  "packageRules": [
   {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "branchPrefix": "renovate-terraform-stable-",
      "ignoreUnstable": true,
      "versioning": "semver",
       "groupName": "{{ replace '^environments\\/(.*?)\\/.*$' '$1' packageFileDir }}",
  "matchFileNames": [
    "environments/**"
  ],
  "commitMessageSuffix": "in {{ replace '^environments\\/(.*?)\\/.*$' '$1' packageFileDir }}"
   },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "branchPrefix": "renovate-terraform-prerelease-",
      "ignoreUnstable": false,
      "versioning": "semver",
        "groupName": "{{ replace '^environments\\/(.*?)\\/.*$' '$1' packageFileDir }}",
  "matchFileNames": [
    "environments/**"
  ],
  "commitMessageSuffix": "in {{ replace '^environments\\/(.*?)\\/.*$' '$1' packageFileDir }}"
    }
  ]
}
