{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "branchPrefix": "renovate-terraform-prerelease-",
      "ignoreUnstable": false,
      "matchNewValue": "/^v?\\d+\\.\\d+\\.\\d+-[a-zA-Z0-9.-]+$/"
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "module"
      ],
      "branchPrefix": "renovate-terraform-stable-",
      "ignoreUnstable": true
    }
  ]
}
