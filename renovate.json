{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["module"],
      "branchPrefix": "renovate-terraform-prerelease-",
      "ignoreUnstable": false,
      "stabilityDays": 0
    },
    {
      "matchManagers": ["terraform"],
      "matchDepTypes": ["module"],
      "branchPrefix": "renovate-terraform-stable-",
      "ignoreUnstable": true,
      "stabilityDays": 0
    }
  ]
}
